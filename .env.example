# ---- copy to .env and edit. Never commit .env.
VMS_ENV=dev
VMS_LOG_LEVEL=INFO

# Control plane
POSTGRES_USER=vms
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=vms
VMS_DATABASE_URL=postgresql+asyncpg://vms:change-me-postgres@postgres:5432/vms
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VMS_FERNET_KEY=5IA--dEDgyx5CKImCMCl72wmmP7XsyVEnNbaU2uRHcw=
# generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
VMS_JWT_SECRET=
VMS_ADMIN_USERNAME=admin
VMS_ADMIN_PASSWORD=change-me-admin
VMS_VIEWER_USERNAME=viewer
VMS_VIEWER_PASSWORD=change-me-viewer
VMS_CAMERA_ALLOWED_CIDRS=[]            # e.g. ["192.168.1.0/24"]  (JSON list)
VMS_ALLOW_SYNTHETIC_SOURCES=false      # true only for CPU/dev testing

# Kafka (KRaft)
VMS_BUS=kafka
VMS_KAFKA_BOOTSTRAP=kafka:9092

# MediaMTX
VMS_MEDIAMTX_HOST=mediamtx
VMS_MEDIAMTX_RTSP_PORT=8554
VMS_MEDIAMTX_API_URL=http://mediamtx:9997
MTX_PUBLISH_USER=publisher
MTX_PUBLISH_PASS=change-me-publish
MTX_READ_USER=viewer
MTX_READ_PASS=change-me-read
MTX_API_USER=api
MTX_API_PASS=change-me-api
VMS_MEDIAMTX_PUBLISH_USER=publisher
VMS_MEDIAMTX_PUBLISH_PASS=change-me-publish
# Browser-facing URLs: must match the host ports published in docker-compose.yml
VMS_PUBLIC_WEBRTC_BASE=http://localhost:8889
VMS_STREAM_POLICY=always               # always | on_demand

# GPU worker
VMS_REQUIRE_CUDA=true                  # GPU system: worker refuses to start without CUDA
VMS_FORCE_MOCK_MODELS=false            # true only for CPU/dev: maps all models to mock
VMS_GPU_ID=0                           # index INSIDE the container
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Frontend integration
# JSON list of browser origins allowed to call the API (the frontend's address)
VMS_CORS_ORIGINS=["http://localhost:5173"]
# Address browsers use to reach this server, for WebRTC video (add the server IP/domain)
WEBRTC_ADDITIONAL_HOSTS=127.0.0.1
WEBRTC_ALLOW_ORIGIN=*
