{
 "uid": "vms-overview",
 "title": "VMS - System overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "tags": [
  "vms"
 ],
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Healthy workers (heartbeat < 15s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(worker_heartbeat_age_seconds < 15) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Active cameras (sum over workers)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(active_cameras) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Connected cameras",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(camera_connection_status) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Dropped frames / s (all)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(dropped_frames_total[5m]))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Detections / s (all)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(detections_total[1m]))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Worker heartbeat age",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "worker_heartbeat_age_seconds",
     "legendFormat": "{{worker_id}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Active cameras per worker",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "active_cameras",
     "legendFormat": "{{worker_id}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "End-to-end latency P95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, worker_id) (rate(end_to_end_latency_seconds_bucket[5m])))",
     "legendFormat": "{{worker_id}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Stream publish status",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "stream_publish_status",
     "legendFormat": "{{worker_id}} {{camera_id}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  }
 ],
 "templating": {
  "list": []
 }
}