{
 "uid": "vms-kafka",
 "title": "VMS - Kafka health",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "tags": [
  "vms"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Publish errors / drops (increase 5m)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (component, reason) (increase(kafka_publish_errors_total[5m]))",
     "legendFormat": "{{component}} {{reason}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Control-plane commands by result",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (type, result) (rate(control_plane_commands_total[5m]))",
     "legendFormat": "{{type}} {{result}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Broker up (kafka-exporter)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 6,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kafka_brokers",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Consumer group lag",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 8,
    "w": 18,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag)",
     "legendFormat": "{{consumergroup}} {{topic}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Messages in / s by topic",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset[1m]))",
     "legendFormat": "{{topic}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  }
 ],
 "templating": {
  "list": []
 }
}