{
 "uid": "vms-inference",
 "title": "VMS - Inference latency & throughput",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "tags": [
  "vms"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Model inference latency P50/P95/P99",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, worker_id, model) (rate(inference_latency_seconds_bucket[5m])))",
     "legendFormat": "{{worker_id}} {{model}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le, worker_id, model) (rate(inference_latency_seconds_bucket[5m])))",
     "legendFormat": "{{worker_id}} {{model}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le, worker_id, model) (rate(inference_latency_seconds_bucket[5m])))",
     "legendFormat": "{{worker_id}} {{model}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
